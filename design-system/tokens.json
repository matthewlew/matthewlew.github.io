        "leading": { "value": "{global.leading.normal}", "type": "lineHeights" },
        "tracking": { "value": "{global.tracking.normal}", "type": "letterSpacing" }
      }
    }
  },
  "theme-light": {
    "surface": {
      "plain": {
        "background": { "value": "#FFFFFF", "type": "color" },
        "text": { "value": "{global.grey.900}", "type": "color" }
      }
    }
  },
  "theme-dark": {
    "surface": {
      "plain": {
        "background": { "value": "{global.grey.900}", "type": "color" },
        "text": { "value": "#FFFFFF", "type": "color" }

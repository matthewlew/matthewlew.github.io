      "4": { "value": "16", "type": "fontSizes" },
      "6": { "value": "24", "type": "fontSizes" }
    },
    "leading": {
      "none": { "value": "1", "type": "lineHeights" },
      "tight": { "value": "1.15", "type": "lineHeights" },
      "normal": { "value": "1.4", "type": "lineHeights" }
    },
    "tracking": {
      "tighter": { "value": "-4%", "type": "letterSpacing" },
      "tight": { "value": "-2%", "type": "letterSpacing" },
      "normal": { "value": "0%", "type": "letterSpacing" }
